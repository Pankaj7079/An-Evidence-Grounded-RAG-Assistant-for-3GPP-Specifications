# LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Embedding Model (HuggingFace local model)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Database
VECTOR_BACKEND=qdrant
QDRANT_PATH=storage/qdrant
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME=threegpp_specs
BM25_INDEX_PATH=storage/bm25_index.pkl
RELATIONSHIPS_DIR=storage/relationships

# Retrieval & Evidence Gate Hyperparameters
TOP_K=8
FINAL_CONTEXT_K=4
MIN_RELEVANCE_SCORE=0.35
RRF_K=60

# Generation
TEMPERATURE=0.0
MAX_OUTPUT_TOKENS=1024
